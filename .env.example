# 本文件完全可选；不创建 .env 也可直接 docker compose up -d。
# 实例密钥和数据库密码由 Compose 首次启动时生成到 ./data/config，切勿手工替换。
POSTGRES_DB=docflow
POSTGRES_USER=docflow

# 可选覆盖项
APP_NAME=文流
HTTP_PORT=38100
MAX_UPLOAD_MB=200
TRANSLATION_CHUNK_CHARS=12000
# 单篇文档最多同时占用的翻译槽；全站池仍会在用户间使用 FIFO 公平排队
TRANSLATION_PER_DOCUMENT_CONCURRENCY=8
TRANSLATION_QUEUE_CAPACITY=4096
# 默认值远低于服务商上限；Google 另有内置 80% 字符/请求分钟配额保护
GOOGLE_TRANSLATION_CONCURRENCY=32
# DeepSeek 官方账号并发 2500，程序硬钳制为其 80%（2000），VPS 默认只开 64
DEEPSEEK_TRANSLATION_CONCURRENCY=64
MINERU_POLL_SECONDS=5
MINERU_MAX_WAIT_SECONDS=7200
WEBP_QUALITY=88
PDF_RENDER_TIMEOUT_SECONDS=180
# 本地原生 PDF 排版进程数（1–4）；不是额外翻译池，两个模式仍共用全站限流
PDF2ZH_CONCURRENCY=1
# 原生 PDF 单次执行总时限（300–14400 秒），超时保留源文件和翻译断点
PDF2ZH_TIMEOUT_SECONDS=7200
WORKER_CONCURRENCY=3
DATABASE_POOL_SIZE=20
RUST_LOG=docflow_server=info,tower_http=info
TZ=Asia/Shanghai
# 可选：仅用于 OpenAPI 中生成绝对地址；留空即可自动使用当前访问入口
PUBLIC_ORIGIN=

# MinerU、Google Cloud Translation、DeepSeek 与 Cloudflare R2 凭据均在 /admin 配置。
