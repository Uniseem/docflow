# 本文件完全可选；不创建 .env 也可直接 docker compose up -d。
# 实例密钥和数据库密码由 Compose 首次启动时生成到 ./data/config，切勿手工替换。
POSTGRES_DB=docflow
POSTGRES_USER=docflow

# 可选覆盖项
APP_NAME=文流
HTTP_PORT=38100
MAX_UPLOAD_MB=200
TRANSLATION_CHUNK_CHARS=12000
MINERU_POLL_SECONDS=5
MINERU_MAX_WAIT_SECONDS=7200
WEBP_QUALITY=88
WORKER_CONCURRENCY=3
DATABASE_POOL_SIZE=20
RUST_LOG=docflow_server=info,tower_http=info
TZ=Asia/Shanghai
# 可选：仅用于 OpenAPI 中生成绝对地址；留空即可自动使用当前访问入口
PUBLIC_ORIGIN=

# MinerU、DeepSeek 与 Cloudflare R2 凭据不写在环境变量中，均在 /admin 配置。
