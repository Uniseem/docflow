# 首次部署前必须修改。建议：openssl rand -hex 32
SECRET_KEY=change-this-to-a-long-random-string

POSTGRES_DB=docflow
POSTGRES_USER=docflow
POSTGRES_PASSWORD=change-this-database-password

# 可选运行参数
APP_NAME=文流
HTTP_PORT=8090
MAX_UPLOAD_MB=200
TRANSLATION_CHUNK_CHARS=12000
MINERU_POLL_SECONDS=5
MINERU_MAX_WAIT_SECONDS=7200
WEBP_QUALITY=88
WORKER_CONCURRENCY=3
DATABASE_POOL_SIZE=20
RUST_LOG=docflow_server=info,tower_http=info
TZ=Asia/Shanghai
# VPS 公网入口（不要以 / 结尾）
PUBLIC_ORIGIN=http://185.99.135.224:8090

# MinerU、DeepSeek 与 Cloudflare R2 凭据不写在环境变量中，均在 /admin 配置。
