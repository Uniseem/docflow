<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DocFlow.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DocFlow">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="DocFlow"
            IsBackButtonVisible="True"
            IsPaneToggleButtonVisible="True"
            BackRequested="OnBackRequested"
            PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
            </TitleBar.IconSource>
            <AutoSuggestBox
                x:Name="SearchBox"
                MinWidth="320"
                MaxWidth="480"
                VerticalAlignment="Center"
                PlaceholderText="搜索文档"
                QueryIcon="Find"
                TextChanged="OnSearchTextChanged"
                QuerySubmitted="OnSearchSubmitted" />
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            PaneDisplayMode="Left"
            OpenPaneLength="240"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="LibraryItem" Content="文档库" Tag="library">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="ActiveBadge" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NewItem" Content="新建翻译" Tag="new">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <InfoBar
                    x:Name="EngineInfoBar"
                    Margin="24,12,24,0"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Informational">
                    <InfoBar.ActionButton>
                        <Button x:Name="EngineRetryButton" Content="重新启动引擎" Click="OnRestartEngine" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <Frame x:Name="ContentFrame" Grid.Row="1" Navigated="OnNavigated" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
