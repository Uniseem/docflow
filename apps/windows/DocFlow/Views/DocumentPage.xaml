<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DocFlow.Views.DocumentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DocFlow.ViewModels"
    xmlns:helpers="using:DocFlow.Helpers">

    <Page.Resources>
        <DataTemplate x:Key="EventTemplate" x:DataType="vm:EventItemViewModel">
            <Grid Padding="0,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="16" Margin="0,2,0,0" VerticalAlignment="Top">
                    <FontIcon Glyph="&#xEC61;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind helpers:Format.Show(IsSuccess)}" />
                    <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind helpers:Format.Show(IsWarning)}" />
                    <FontIcon Glyph="&#xEB90;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind helpers:Format.Show(IsError)}" />
                    <FontIcon Glyph="&#xE91F;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind helpers:Format.Show(IsInfo)}" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock
                        Text="{x:Bind Detail}"
                        Style="{StaticResource SecondaryTextBlockStyle}"
                        IsTextSelectionEnabled="True"
                        Visibility="{x:Bind helpers:Format.ShowText(Detail)}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{x:Bind Time}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind Elapsed}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind Progress}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind Counter}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="36,20,36,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Spacing="4">
            <TextBlock
                Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                Style="{StaticResource TitleTextBlockStyle}"
                TextWrapping="Wrap"
                MaxLines="2"
                TextTrimming="CharacterEllipsis"
                IsTextSelectionEnabled="True" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border
                    Padding="8,2"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
                <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource SecondaryTextBlockStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>

        <!-- View switcher and commands -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar
                x:Name="ViewBar"
                Margin="-12,0,0,0"
                Visibility="{x:Bind helpers:Format.Show(ViewModel.IsCompleted), Mode=OneWay}"
                SelectionChanged="OnViewChanged" />
            <CommandBar
                Grid.Column="1"
                Background="Transparent"
                DefaultLabelPosition="Right"
                IsOpen="False"
                OverflowButtonVisibility="Auto">
                <AppBarToggleButton
                    x:Name="SerifToggle"
                    Label="衬线字体"
                    Visibility="Collapsed"
                    Click="OnSerifToggled">
                    <AppBarToggleButton.Icon>
                        <FontIcon Glyph="&#xE8D2;" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarButton x:Name="OpenButton" Label="打开" Click="OnOpenPrimary" Visibility="{x:Bind helpers:Format.Show(ViewModel.IsCompleted), Mode=OneWay}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8E5;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="ExportButton" Label="导出" Visibility="{x:Bind helpers:Format.Show(ViewModel.IsCompleted), Mode=OneWay}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xEDE1;" />
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="ExportMenu" Placement="BottomEdgeAlignedRight" />
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton Label="重新处理" Click="OnRetry" Visibility="{x:Bind helpers:Format.Show(ViewModel.IsStopped), Mode=OneWay}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE72C;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="取消处理" Click="OnCancel" Visibility="{x:Bind helpers:Format.Show(ViewModel.IsActive), Mode=OneWay}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE711;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton Label="在文件资源管理器中显示" Click="OnReveal">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE838;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="重命名" Click="OnRename">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8AC;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton Label="删除" Click="OnDelete">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE74D;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <!-- Processing / stopped: progress, stages and the live log -->
        <Grid
            x:Name="ProgressPanel"
            Grid.Row="2"
            Padding="0,4,0,24"
            RowSpacing="12"
            Visibility="{x:Bind helpers:Format.Hide(ViewModel.IsCompleted), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="{x:Bind ProgressTitle(ViewModel.IsActive, ViewModel.StatusText), Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Percent(ViewModel.Progress), Mode=OneWay}" />
                    </Grid>
                    <ProgressBar
                        Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                        Maximum="100"
                        ShowError="{x:Bind ViewModel.IsStopped, Mode=OneWay}"
                        IsIndeterminate="{x:Bind IsWaiting(ViewModel.IsActive, ViewModel.Progress), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.CurrentMessage, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind ViewModel.CurrentDetail, Mode=OneWay}"
                        Style="{StaticResource SecondaryTextBlockStyle}"
                        IsTextSelectionEnabled="True"
                        MaxLines="4"
                        Visibility="{x:Bind helpers:Format.ShowText(ViewModel.CurrentDetail), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>

            <InfoBar
                Grid.Row="1"
                Severity="Error"
                IsClosable="False"
                Title="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                Message="{x:Bind FailureText(ViewModel.Document), Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.IsStopped, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="重新处理" Click="OnRetry" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorderStyle}" Padding="16,12,4,12">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="处理阶段" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ScrollViewer Grid.Row="1" Padding="0,0,12,0">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Stages}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="14" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StageItemViewModel">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid VerticalAlignment="Top" Margin="0,1,0,0">
                                            <FontIcon Glyph="&#xEC61;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind helpers:Format.Show(IsDone), Mode=OneWay}" />
                                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind IsCurrent, Mode=OneWay}" Visibility="{x:Bind helpers:Format.Show(IsCurrent), Mode=OneWay}" />
                                            <FontIcon Glyph="&#xEB90;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind helpers:Format.Show(IsError), Mode=OneWay}" />
                                            <FontIcon Glyph="&#xEA3A;" FontSize="16" Foreground="{ThemeResource TextFillColorDisabledBrush}" Visibility="{x:Bind helpers:Format.Show(IsWaiting), Mode=OneWay}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{x:Bind Title}" />
                                            <TextBlock Text="{x:Bind Caption}" Style="{StaticResource SecondaryTextBlockStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16,12,4,0">
                    <Grid RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="0,0,12,0">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Text="{x:Bind LogTitle(ViewModel.EventTotal), Mode=OneWay}" />
                            <ToggleSwitch
                                HorizontalAlignment="Right"
                                OnContent="只看警告和错误"
                                OffContent="只看警告和错误"
                                IsOn="{x:Bind ViewModel.OnlyAttention, Mode=TwoWay}" />
                        </Grid>
                        <ListView
                            Grid.Row="1"
                            SelectionMode="None"
                            ItemsSource="{x:Bind ViewModel.Events}"
                            ItemTemplate="{StaticResource EventTemplate}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Completed: reading view, PDFs and the log -->
        <Grid
            x:Name="ResultPanel"
            Grid.Row="2"
            Margin="0,0,0,16"
            Visibility="{x:Bind helpers:Format.Show(ViewModel.IsCompleted), Mode=OneWay}">
            <Border
                x:Name="ViewerHost"
                Style="{StaticResource CardBorderStyle}"
                Padding="0">
                <WebView2 x:Name="Viewer" />
            </Border>
            <Border
                x:Name="LogHost"
                Style="{StaticResource CardBorderStyle}"
                Padding="16,12,4,0"
                Visibility="Collapsed">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="0,0,12,0">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Text="{x:Bind LogTitle(ViewModel.EventTotal), Mode=OneWay}" />
                        <ToggleSwitch
                            HorizontalAlignment="Right"
                            OnContent="只看警告和错误"
                            OffContent="只看警告和错误"
                            IsOn="{x:Bind ViewModel.OnlyAttention, Mode=TwoWay}" />
                    </Grid>
                    <ListView
                        Grid.Row="1"
                        SelectionMode="None"
                        ItemsSource="{x:Bind ViewModel.Events}"
                        ItemTemplate="{StaticResource EventTemplate}" />
                </Grid>
            </Border>
        </Grid>

        <InfoBar
            Grid.Row="2"
            VerticalAlignment="Top"
            Severity="Error"
            Title="无法打开文档"
            Message="{x:Bind ViewModel.LoadError, Mode=OneWay}"
            IsOpen="{x:Bind HasText(ViewModel.LoadError), Mode=OneWay}"
            IsClosable="False" />

        <!-- A finished export; it closes by itself. Failures use a dialog. -->
        <InfoBar
            x:Name="ExportInfo"
            Grid.Row="2"
            MaxWidth="720"
            Margin="0,8,0,0"
            VerticalAlignment="Top"
            Severity="Success"
            Title="导出成功"
            IsClosable="True"
            IsOpen="False">
            <InfoBar.ActionButton>
                <Button Content="打开所在文件夹" Click="OnRevealExport" />
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Page>
