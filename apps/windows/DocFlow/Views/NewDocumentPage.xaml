<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DocFlow.Views.NewDocumentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DocFlow.ViewModels"
    xmlns:services="using:DocFlow.Services"
    xmlns:helpers="using:DocFlow.Helpers"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="ScrollHost" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <!-- A viewport-wide wrapper keeps the max-width column centred; the
             ScrollViewer otherwise re-centres content by its desired width. -->
        <Grid MinWidth="{x:Bind ScrollHost.ViewportWidth, Mode=OneWay}">
        <StackPanel
            x:Name="ContentHost"
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="{StaticResource PagePadding}"
            HorizontalAlignment="Stretch"
            Spacing="4">
            <TextBlock Text="新建翻译" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

            <InfoBar
                Severity="Warning"
                Title="还不能开始"
                Message="{x:Bind ViewModel.Issue, Mode=OneWay}"
                IsOpen="{x:Bind HasText(ViewModel.Issue), Mode=OneWay}"
                IsClosable="False">
                <InfoBar.ActionButton>
                    <Button Content="打开设置" Click="OnOpenSettings" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Files -->
            <Border
                x:Name="DropZone"
                Style="{StaticResource CardBorderStyle}"
                Padding="24"
                AllowDrop="True"
                DragOver="OnDragOver"
                DragLeave="OnDragLeave"
                Drop="OnDrop">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE898;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="把文件拖到这里" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.AcceptedHint, Mode=OneWay}" Style="{StaticResource SecondaryTextBlockStyle}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="选择文件…" Click="OnPickFiles" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Files}" Visibility="{x:Bind helpers:Format.Show(ViewModel.HasFiles), Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PendingFile">
                                <Grid
                                    Padding="12,8"
                                    ColumnSpacing="12"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource SecondaryTextBlockStyle}" />
                                        <TextBlock
                                            Text="{x:Bind Problem, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind helpers:Format.ShowText(Problem), Mode=OneWay}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="2"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="移除"
                                        AutomationProperties.Name="移除"
                                        Tag="{x:Bind}"
                                        Click="OnRemoveFile">
                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Processing mode -->
            <TextBlock Text="处理方式" Style="{StaticResource SectionHeaderTextBlockStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <RadioButton GroupName="Mode" IsChecked="{x:Bind ViewModel.IsNative, Mode=TwoWay}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="PDF 原生翻译" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource SecondaryTextBlockStyle}" Text="保留原 PDF 的页面布局、图片和公式，生成中文 PDF 与双语对照 PDF。基于 BabelDOC，在本机排版，不需要 MinerU。" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Mode" IsChecked="{x:Bind ViewModel.IsMineru, Mode=TwoWay}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="MinerU 解析翻译" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource SecondaryTextBlockStyle}" Text="由 MinerU 云端识别正文、表格、图片和公式，生成可阅读的 Markdown 译文与期刊排版 PDF。支持 Office 文档、图片和扫描件。" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Translation service -->
            <TextBlock Text="翻译服务" Style="{StaticResource SectionHeaderTextBlockStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <ComboBox
                        MinWidth="320"
                        MaxWidth="520"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="翻译服务"
                        ItemsSource="{x:Bind ViewModel.Translators}"
                        SelectedItem="{x:Bind ViewModel.Translator, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="services:TranslatorOption">
                                <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{x:Bind ViewModel.TranslatorDetail, Mode=OneWay}" Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind helpers:Format.Hide(ViewModel.LlmReady), Mode=OneWay}">
                        <TextBlock Style="{StaticResource SecondaryTextBlockStyle}" VerticalAlignment="Center" Text="想用 DeepSeek、通义千问、Kimi、Claude 等大模型翻译？" />
                        <HyperlinkButton Padding="2,0" Content="在设置中添加服务商" Click="OnOpenSettings" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <!-- Title -->
            <StackPanel Visibility="{x:Bind helpers:Format.Show(ViewModel.IsSingleFile), Mode=OneWay}">
                <TextBlock Text="标题" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                <TextBox
                    Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="默认使用文件名"
                    MaxLength="300" />
            </StackPanel>

            <InfoBar
                Margin="0,16,0,0"
                Severity="Error"
                Title="部分文件未能添加"
                Message="{x:Bind ViewModel.SubmitError, Mode=OneWay}"
                IsOpen="{x:Bind HasText(ViewModel.SubmitError), Mode=OneWay}"
                IsClosable="True" />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,24,0,0">
                <Button
                    AutomationProperties.Name="开始处理"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="120"
                    IsEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}"
                    Click="OnSubmit">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsSubmitting, Mode=OneWay}" Visibility="{x:Bind helpers:Format.Show(ViewModel.IsSubmitting), Mode=OneWay}" />
                        <TextBlock Text="开始处理" />
                    </StackPanel>
                </Button>
                <Button Content="清空" Click="OnClear" IsEnabled="{x:Bind ViewModel.HasFiles, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
