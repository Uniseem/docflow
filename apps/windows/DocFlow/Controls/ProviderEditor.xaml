<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DocFlow.Controls.ProviderEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DocFlow.ViewModels"
    xmlns:helpers="using:DocFlow.Helpers"
    HorizontalAlignment="Stretch">
    <Expander Style="{StaticResource SettingsExpanderStyle}" IsExpanded="{x:Bind Provider.IsExpanded, Mode=TwoWay}">
        <Expander.Header>
            <Grid ColumnSpacing="16" Padding="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="16" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <TextBlock
                        Text="{x:Bind Provider.Initial, Mode=OneWay}"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Provider.Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Provider.Summary, Mode=OneWay}" Style="{StaticResource SecondaryTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xEC61;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind helpers:Format.Show(Provider.IsUsable), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Provider.StatusText, Mode=OneWay}" Style="{StaticResource SecondaryTextBlockStyle}" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="3"
                    MinWidth="0"
                    OnContent=""
                    OffContent=""
                    VerticalAlignment="Center"
                    AutomationProperties.Name="启用"
                    ToolTipService.ToolTip="启用或停用这个服务商"
                    IsOn="{x:Bind Provider.Enabled, Mode=TwoWay}" />
            </Grid>
        </Expander.Header>

        <StackPanel Spacing="20">
            <!-- API key -->
            <StackPanel Spacing="6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="API Key" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Provider.KeyStatus, Mode=OneWay}" Style="{StaticResource SecondaryTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <HyperlinkButton
                        Grid.Column="1"
                        Padding="4,0"
                        Content="获取 API Key"
                        NavigateUri="{x:Bind KeyUri(Provider.KeyUrl), Mode=OneWay}"
                        Visibility="{x:Bind helpers:Format.Show(Provider.HasKeyUrl), Mode=OneWay}" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox
                        Password="{x:Bind Provider.KeyInput, Mode=TwoWay}"
                        PlaceholderText="{x:Bind Provider.KeyPlaceholder, Mode=OneWay}"
                        IsEnabled="{x:Bind helpers:Format.Not(Provider.IsBusy), Mode=OneWay}" />
                    <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Content="保存" Click="OnSaveKey" IsEnabled="{x:Bind helpers:Format.Not(Provider.IsBusy), Mode=OneWay}" />
                    <Button Grid.Column="2" Content="移除" Click="OnRemoveKey" IsEnabled="{x:Bind Provider.KeyConfigured, Mode=OneWay}" />
                </Grid>
            </StackPanel>

            <!-- API address -->
            <StackPanel Spacing="4">
                <TextBox
                    Header="API 地址"
                    InputScope="Url"
                    Text="{x:Bind Provider.BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    LostFocus="OnCommitText" />
                <TextBlock
                    Text="{x:Bind Provider.EndpointPreview, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- Models -->
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="模型" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Click="OnFetchModels" IsEnabled="{x:Bind helpers:Format.Not(Provider.IsFetching), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="14" Height="14" IsActive="{x:Bind Provider.IsFetching, Mode=OneWay}" Visibility="{x:Bind helpers:Format.Show(Provider.IsFetching), Mode=OneWay}" />
                            <FontIcon Glyph="&#xE895;" FontSize="14" Visibility="{x:Bind helpers:Format.Hide(Provider.IsFetching), Mode=OneWay}" />
                            <TextBlock Text="获取模型列表" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Click="OnAddModel">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="手动添加" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock
                    Style="{StaticResource SecondaryTextBlockStyle}"
                    TextWrapping="Wrap"
                    Text="还没有模型。填写 API Key 后点“获取模型列表”，或按服务商文档手动添加模型 ID。"
                    Visibility="{x:Bind helpers:Format.Hide(Provider.HasModels), Mode=OneWay}" />
                <ItemsControl ItemsSource="{x:Bind Provider.Models, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModelItemViewModel">
                            <Grid
                                Padding="12,6"
                                ColumnSpacing="8"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                                    <TextBlock
                                        Text="{x:Bind CheckResult, Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        IsTextSelectionEnabled="True"
                                        Foreground="{x:Bind helpers:Brushes.Status(CheckFailed), Mode=OneWay}"
                                        Visibility="{x:Bind helpers:Format.ShowText(CheckResult), Mode=OneWay}" />
                                </StackPanel>
                                <Button Grid.Column="1" Tag="{x:Bind}" Click="OnCheckModel" IsEnabled="{x:Bind helpers:Format.Not(IsChecking), Mode=OneWay}" ToolTipService.ToolTip="用这个模型发送一个测试请求">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ProgressRing Width="12" Height="12" IsActive="{x:Bind IsChecking, Mode=OneWay}" Visibility="{x:Bind helpers:Format.Show(IsChecking), Mode=OneWay}" />
                                        <TextBlock Text="检查" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Column="2"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Tag="{x:Bind}"
                                    Click="OnRemoveModel"
                                    AutomationProperties.Name="移除模型"
                                    ToolTipService.ToolTip="移除模型">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Concurrency -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="并发请求数" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap" Text="同时发往这个服务商的请求上限，所有文档共用；默认 100。遇到限流（HTTP 429）会自动减半，恢复后逐步回升。" />
                </StackPanel>
                <NumberBox
                    Grid.Column="1"
                    MinWidth="140"
                    Minimum="1"
                    Maximum="{x:Bind MaxConcurrency, Mode=OneWay}"
                    SmallChange="10"
                    LargeChange="100"
                    SpinButtonPlacementMode="Compact"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="并发请求数"
                    Value="{x:Bind Provider.Concurrency, Mode=TwoWay}" />
            </Grid>

            <!-- Name and extra parameters -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Header="显示名称" MaxLength="64" Text="{x:Bind Provider.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" LostFocus="OnCommitText" />
                <TextBox Grid.Column="1" Header="接口类型" IsReadOnly="True" Text="{x:Bind Provider.TypeLabel, Mode=OneWay}" />
            </Grid>
            <TextBox
                Header="附加请求参数（JSON，可选）"
                PlaceholderText="例如 {&quot;temperature&quot;: 0.3} 或关闭思考模式的参数，会合并进每个请求"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                MinHeight="64"
                MaxHeight="200"
                FontFamily="Consolas"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Text="{x:Bind Provider.ExtraBodyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                LostFocus="OnCommitText" />

            <TextBlock
                Text="{x:Bind Provider.Message, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                IsTextSelectionEnabled="True"
                Foreground="{x:Bind helpers:Brushes.Status(Provider.MessageIsError), Mode=OneWay}"
                Visibility="{x:Bind helpers:Format.ShowText(Provider.Message), Mode=OneWay}" />

            <Button Content="删除服务商" Click="OnDelete" />
        </StackPanel>
    </Expander>
</UserControl>
