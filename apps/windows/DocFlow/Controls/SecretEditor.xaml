<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DocFlow.Controls.SecretEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:DocFlow.Helpers"
    HorizontalAlignment="Stretch">
    <Expander Style="{StaticResource SettingsExpanderStyle}">
        <Expander.Header>
            <Grid ColumnSpacing="16" Padding="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE192;" FontSize="20" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Row.Title, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Row.Description, Mode=OneWay}" Style="{StaticResource SecondaryTextBlockStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xEC61;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind helpers:Format.Show(Row.Configured), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Row.Status, Mode=OneWay}" Style="{StaticResource SecondaryTextBlockStyle}" />
                </StackPanel>
            </Grid>
        </Expander.Header>
        <StackPanel Spacing="12">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox
                    Password="{x:Bind Row.Input, Mode=TwoWay}"
                    PlaceholderText="{x:Bind Placeholder(Row.Configured), Mode=OneWay}"
                    IsEnabled="{x:Bind helpers:Format.Not(Row.IsBusy), Mode=OneWay}" />
                <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="验证并保存" Click="OnSave" IsEnabled="{x:Bind helpers:Format.Not(Row.IsBusy), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing Width="14" Height="14" IsActive="{x:Bind Row.IsBusy, Mode=OneWay}" Visibility="{x:Bind helpers:Format.Show(Row.IsBusy), Mode=OneWay}" />
                        <TextBlock Text="验证并保存" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Content="移除" Click="OnRemove" IsEnabled="{x:Bind Row.Configured, Mode=OneWay}" />
            </Grid>
            <TextBlock
                Text="{x:Bind Row.Message, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Visibility="{x:Bind MessageVisible(Row.Message, Row.MessageIsError, x:True), Mode=OneWay}" />
            <TextBlock
                Text="{x:Bind Row.Message, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                Visibility="{x:Bind MessageVisible(Row.Message, Row.MessageIsError, x:False), Mode=OneWay}" />
            <ContentPresenter Content="{x:Bind Extra, Mode=OneWay}" />
        </StackPanel>
    </Expander>
</UserControl>
